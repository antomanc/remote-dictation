<?xml version="1.0" encoding="utf-8"?>
<!-- Scrolls so the D-pad can reach everything on small or zoomed TV screens. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF121212">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="96dp"
    android:paddingVertical="48dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="#FFFFFFFF"
        android:textSize="40sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/setup_intro"
        android:textColor="#FFB0B0B0"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/mic_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:textColor="#FFFFFFFF"
        android:textSize="22sp" />

    <Button
        android:id="@+id/mic_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/setup_mic_button" />

    <TextView
        android:id="@+id/service_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:textColor="#FFFFFFFF"
        android:textSize="22sp" />

    <Button
        android:id="@+id/service_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/setup_service_button" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/setup_engine_title"
        android:textColor="#FFFFFFFF"
        android:textSize="22sp" />

    <RadioGroup
        android:id="@+id/engine_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">

        <RadioButton
            android:id="@+id/engine_whisper"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/setup_engine_whisper"
            android:textColor="#FFFFFFFF"
            android:textSize="20sp" />

        <RadioButton
            android:id="@+id/engine_vosk"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/setup_engine_vosk"
            android:textColor="#FFFFFFFF"
            android:textSize="20sp" />
    </RadioGroup>
</LinearLayout>
</ScrollView>
